* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.txt text eol=lf
Procfile text eol=lf

*.pdf binary
*.xlsx binary
*.mp3 binary
*.png binary
*.jpg binary
*.jpeg binary

# raw/ holds scraped source documents (PDF extractions with stray control bytes);
# eol normalization can't round-trip them and leaves files perpetually "modified"
raw/** -text
